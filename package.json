{
  "name": "otel-node-app",
  "version": "1.0.0",
  "description": "A simple Node.js application auto-instrumented with OpenTelemetry.",
  "main": "src/app.js",
  "scripts": {
    "start": "node --require ./src/telemetry.js src/app.js",
    "dev": "nodemon --require ./src/telemetry.js src/app.js",
    "dev:watch": "nodemon --require ./src/telemetry.js src/app.js --watch src --ext js,json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.201.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "express": "^4.17.1"
  },
  "devDependencies": {
    "dotenv": "^10.0.0",
    "nodemon": "^3.1.10"
  },
  "license": "MIT"
}
